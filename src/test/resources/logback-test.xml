<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        NOTE: TestNG Foundation's own logback.xml also references a "TestNG" appender
        (com.github.sbabcoc.logback.testng.ReporterAppender), which routes log output into TestNG's
        own Reporter so it's captured per-test in TestNG's result artifacts. There is no JUnit 5
        equivalent of that bridge - ReporterAppender reflects directly against org.testng.Reporter/
        ITestResult, neither of which exists on this classpath. Building an equivalent for Jupiter
        would mean a custom appender writing through ExtensionContext.publishReportEntry(...), which
        needs a live ExtensionContext for "the currently running test" the way getExtensionContext()
        provides elsewhere in this project - real, separate work, not something to fake here.
    -->

    <root level="debug">
        <appender-ref ref="STDOUT" />
    </root>

    <!--
        Keeps everything else at DEBUG (JupiterConfig's own diagnostic messages, etc.) while dropping
        RetryExtension's own logger below DEBUG - this is what actually controls stack-trace verbosity
        per retry, via RetryExtension.logRetry()'s "LOGGER.isDebugEnabled() || RETRY_MORE_INFO" check.
        At INFO, isDebugEnabled() is false, so each retry logs its compact one-line form
        ("### RETRY ### ClassName.methodName(...)") with no stack trace attached, unless
        jupiter.retry.more.info=true is explicitly set (system property or jupiter.properties) to opt
        back into full detail on a per-run basis without touching this file again.
    -->
    <logger name="com.nordstrom.automation.jupiter.RetryExtension" level="info" />

    <!--
        NOTE: TestNG Foundation's own config also suppresses org.apache/httpclient/org.eclipse.jetty/
        org.seleniumhq.jetty9 to ERROR - all Selenium Grid/HTTP-client noise from ITS test suite, which
        actually exercises Grid components. Jupiter Foundation depends on none of that, so those
        suppressions would be dead configuration for packages not on this classpath at all - omitted
        rather than carried over unexamined.
    -->
</configuration>
